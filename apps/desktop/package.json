{
  "name": "desktop",
  "version": "0.1.0",
  "description": "Project Resonance — Electron desktop shell",
  "private": true,
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"pnpm dev:renderer\" \"pnpm dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "pnpm build:renderer && pnpm build:main",
    "package": "pnpm build && electron-builder",
    "build:win": "pnpm build && electron-builder build --win --x64",
    "build:portable": "pnpm build && electron-builder build --win portable"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.0",
    "ai-transcriber": "workspace:*",
    "electron-is-dev": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "library-core": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "react-window": "^2.5.0",
    "three": "^0.184.0",
    "visual-engine": "workspace:*",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
